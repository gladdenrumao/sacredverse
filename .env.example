# Supabase Configuration
# Copy this file to .env and fill in your Supabase credentials

# Your Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Never commit the actual .env file to git!
# The .env file is already in .gitignore to protect your credentials
